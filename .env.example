# Login Microsoft (Entra ID) — só SSO, sem senha local.
# App registration: plataforma Web, tenant único.
# Redirect URI local: http://localhost:3000/api/auth/microsoft/callback
# Redirect URI de produção: https://internaliza-o.vercel.app/api/auth/microsoft/callback
# Permissões delegadas do Graph: openid, profile, email, User.Read
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_SCOPE="openid profile email User.Read"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/microsoft/callback"
APP_SESSION_SECRET=""
APP_SESSION_TTL_SEC="2592000"
PUBLIC_APP_ORIGIN="http://localhost:3000"
